{
  "displayName": "miniLM kNN Index Health",
  "mosaicLayout": {
    "columns": 12,
    "tiles": [
      {
        "xPos": 0,
        "yPos": 0,
        "width": 4,
        "height": 4,
        "widget": {
          "title": "HNSW Vector Index Memory — data nodes",
          "xyChart": {
            "dataSets": [
              {
                "timeSeriesQuery": {
                  "prometheusQuery": "elasticsearch_indices_segments_vector_index_memory_bytes{namespace=\"greenearth-prod\", node=~\"greenearth-es-data-.*\"}"
                },
                "plotType": "LINE",
                "legendTemplate": "${labels.node}"
              }
            ],
            "yAxis": { "label": "Bytes", "scale": "LINEAR" }
          }
        }
      },
      {
        "xPos": 4,
        "yPos": 0,
        "width": 4,
        "height": 4,
        "widget": {
          "title": "JVM Heap Used — data nodes",
          "xyChart": {
            "dataSets": [
              {
                "timeSeriesQuery": {
                  "prometheusQuery": "elasticsearch_jvm_memory_used_bytes{namespace=\"greenearth-prod\", node=~\"greenearth-es-data-.*\", area=\"heap\"}"
                },
                "plotType": "LINE",
                "legendTemplate": "${labels.node}"
              }
            ],
            "yAxis": { "label": "Bytes", "scale": "LINEAR" }
          }
        }
      },
      {
        "xPos": 8,
        "yPos": 0,
        "width": 4,
        "height": 4,
        "widget": {
          "title": "OS Memory Used — data nodes",
          "xyChart": {
            "dataSets": [
              {
                "timeSeriesQuery": {
                  "prometheusQuery": "elasticsearch_os_mem_used_bytes{namespace=\"greenearth-prod\", node=~\"greenearth-es-data-.*\"}"
                },
                "plotType": "LINE",
                "legendTemplate": "${labels.node}"
              }
            ],
            "yAxis": { "label": "Bytes", "scale": "LINEAR" }
          }
        }
      },
      {
        "xPos": 0,
        "yPos": 4,
        "width": 4,
        "height": 4,
        "widget": {
          "title": "Avg kNN Query Latency — data nodes",
          "xyChart": {
            "dataSets": [
              {
                "timeSeriesQuery": {
                  "prometheusQuery": "rate(elasticsearch_indices_search_query_time_seconds{namespace=\"greenearth-prod\", node=~\"greenearth-es-data-.*\"}[5m]) / rate(elasticsearch_indices_search_query_total{namespace=\"greenearth-prod\", node=~\"greenearth-es-data-.*\"}[5m])"
                },
                "plotType": "LINE",
                "legendTemplate": "${labels.node}"
              }
            ],
            "yAxis": { "label": "s/query", "scale": "LINEAR" }
          }
        }
      },
      {
        "xPos": 4,
        "yPos": 4,
        "width": 4,
        "height": 4,
        "widget": {
          "title": "Search QPS — data nodes",
          "xyChart": {
            "dataSets": [
              {
                "timeSeriesQuery": {
                  "prometheusQuery": "rate(elasticsearch_indices_search_query_total{namespace=\"greenearth-prod\", node=~\"greenearth-es-data-.*\"}[5m])"
                },
                "plotType": "LINE",
                "legendTemplate": "${labels.node}"
              }
            ],
            "yAxis": { "label": "queries/s", "scale": "LINEAR" }
          }
        }
      },
      {
        "xPos": 8,
        "yPos": 4,
        "width": 4,
        "height": 4,
        "widget": {
          "title": "Search Thread Pool Rejections — data nodes",
          "xyChart": {
            "dataSets": [
              {
                "timeSeriesQuery": {
                  "prometheusQuery": "rate(elasticsearch_thread_pool_rejected_count{namespace=\"greenearth-prod\", node=~\"greenearth-es-data-.*\", type=\"search\"}[5m])"
                },
                "plotType": "LINE",
                "legendTemplate": "${labels.node}"
              }
            ],
            "yAxis": { "label": "rejections/s", "scale": "LINEAR" }
          }
        }
      }
    ]
  }
}
